PORT=5011
CLIENT_URL=http://localhost:5173

# "production" makes auth cookies Secure (HTTPS-only) — leave unset/dev locally
NODE_ENV=development
# Only needed if the client and gateway are served from different subdomains
# of the same parent domain in production (e.g. ".example.com")
COOKIE_DOMAIN=

JWT_SECRET=changeme

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=minitube

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=MiniTube
